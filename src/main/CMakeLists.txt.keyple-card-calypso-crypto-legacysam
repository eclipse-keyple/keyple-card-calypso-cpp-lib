# FetchContent added in CMake 3.11, downloads during the configure step
# FetchContent_MakeAvailable was added in CMake 3.14; simpler usage
INCLUDE(FetchContent)

IF(NOT EXISTS "${CMAKE_BINARY_DIR}/_deps/keyplecardcalypsocryptolegacysamcpplib-src")

    MESSAGE("-- > Fetching keyple card calypso crypto legacysam from keyple card calypso")

    # Checkout Keyple Card Generic Cpp Lib dependency
    FetchContent_Declare(

        KeypleCardCalypsoCryptoLegacysamCppLib

        DOWNLOAD_EXTRACT_TIMESTAMP true
        GIT_REPOSITORY https://github.com/eclipse-keyple/keyple-card-calypso-crypto-legacysam-cpp-lib
        GIT_TAG develop-0.9.0
    )

ELSE()

    FetchContent_Declare(

        KeypleCardCalypsoCryptoLegacysamCppLib

        SOURCE_DIR ${CMAKE_BINARY_DIR}/_deps/keyplecardcalypsocryptolegacysamcpplib-src
    )

ENDIF()

FetchContent_MakeAvailable(KeypleCardCalypsoCryptoLegacysamCppLib)
