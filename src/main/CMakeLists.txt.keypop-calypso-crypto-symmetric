INCLUDE(FetchContent)

IF(NOT EXISTS "${CMAKE_BINARY_DIR}/_deps/keypopcalypsocryptosymmetric-src")

    MESSAGE("-- > Fetching keypop calypso crypto symmetric api from keyple card calypso")

    FetchContent_Declare(

            KeypopCalypsoCryptoSymmetricCppApi

            DOWNLOAD_EXTRACT_TIMESTAMP true
            GIT_REPOSITORY https://github.com/eclipse-keypop/keypop-calypso-crypto-symmetric-cpp-api
            GIT_TAG develop-0.1.1
    )

ELSE()

    FetchContent_Declare(

        KeypopCalypsoCryptoSymmetricCppApi

        SOURCE_DIR ${CMAKE_BINARY_DIR}/_deps/keypopcalypsocryptosymmetric-src
    )

ENDIF()

FetchContent_MakeAvailable(KeypopCalypsoCryptoSymmetricCppApi)
