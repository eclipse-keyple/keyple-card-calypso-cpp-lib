INCLUDE(FetchContent)

IF(NOT EXISTS "${CMAKE_BINARY_DIR}/_deps/keypopcalypsocryptolegacysam-src")

    MESSAGE("-- > Fetching keypop calypso crypto legacysam api from keyple card calypso")

    FetchContent_Declare(

            KeypopCalypsoCryptoLegacysamCppApi

            DOWNLOAD_EXTRACT_TIMESTAMP true
            GIT_REPOSITORY https://github.com/eclipse-keypop/keypop-calypso-crypto-legacysam-cpp-api
            GIT_TAG 0.7.0
    )

ELSE()

    FetchContent_Declare(

        KeypopCalypsoCryptoLegacysamCppApi

        SOURCE_DIR ${CMAKE_BINARY_DIR}/_deps/keypopcalypsocryptolegacysam-src
    )

ENDIF()

FetchContent_MakeAvailable(KeypopCalypsoCryptoLegacysamCppApi)
